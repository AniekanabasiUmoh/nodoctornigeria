APP_ENV=development
APP_NAME=NSTG Medical AI Assistant
DATA_PROVIDER=supabase
AUDIT_STORAGE_DIR=build/audit
PUBLIC_BASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# Gemini
ENABLE_GEMINI_ASSIST=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq
ENABLE_GROQ_ASSIST=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LIGHT_MODEL=llama-3.1-8b-instant

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_CLINICAL=
TELEGRAM_WEBHOOK_SECRET=

# Review dashboard
REVIEW_DASHBOARD_TOKEN=
